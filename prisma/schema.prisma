  category    String    @default("Community")
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@map("posts")
}

model MemberConnection {
  id          String   @id @default(cuid())
  requesterId String
  receiverId  String
  // Sorted pair of user IDs — "smaller|larger" — enforces uniqueness across the
  // unordered pair so concurrent A->B and B->A inserts can't both succeed.
  pairKey     String   @unique
  status      String   @default("pending")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId])
  @@index([status])
  @@map("member_connections")
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  adminName String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_notes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  text      String
  // Optional image attachment — validated against the /api/upload regex
  // (/app/api/files/<sub>/<file>.ext). text remains required; can be a single
  // space for an image-only message.
  imageUrl  String?
  // Reply-to — self-referencing FK. SetNull (not Cascade) so deleting the
  // original message keeps the reply visible (it just loses the quote chip).
  replyToId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  from      User                    @relation("SentMessages",     fields: [fromId], references: [id], onDelete: Cascade)
  to        User                    @relation("ReceivedMessages", fields: [toId],   references: [id], onDelete: Cascade)
  replyTo   DirectMessage?          @relation("DMReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   DirectMessage[]         @relation("DMReplyTo")
  reactions DirectMessageReaction[]

  @@index([fromId, toId])
  @@index([toId, isRead])
  @@index([createdAt])
  @@index([replyToId])
  @@map("direct_messages")
}

// WhatsApp-style reactions on direct messages. One emoji per user per
// message (unique constraint); re-reacting with the same emoji removes it,
// re-reacting with a different one switches.
model DirectMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId],    references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("direct_message_reactions")
}

model NeighborhoodPost {
  id           String    @id @default(cuid())
  neighborhood String
  userId       String
  content      String
  imageUrl     String?
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes   NeighborhoodPostLike[]
  replies NeighborhoodPostReply[]

  @@index([neighborhood, isPinned(sort: Desc), createdAt(sort: Desc)])
  @@map("neighborhood_posts")
}

model NeighborhoodPostLike {
  postId    String
  userId    String
  emoji     String   @default("❤️")
  createdAt DateTime @default(now())

  post NeighborhoodPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("neighborhood_post_likes")
}

model NeighborhoodPostReply {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post NeighborhoodPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("neighborhood_post_replies")
}

model Listing {
  id           String   @id @default(cuid())
  userId       String
  category     String // ROOMS | JOBS | BUY_SELL
  title        String
  description  String
  price        String?
  photo        String?
  contact      String? // WhatsApp link or number
  neighborhood String? // One of lib/neighborhoods ISTANBUL_NEIGHBORHOODS, validated server-side
  status       String   @default("active") // active | filled | expired | deleted
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy SavedListing[]

  @@index([category, status, createdAt])
  @@index([neighborhood, status])
  @@index([userId])
  @@map("listings")
}

// Spontaneous "I'm at X right now, anyone wanna join?" meetups. Lighter than
// Events — no RSVP, no quota, no approval. Auto-expires after the window so
// the page stays current. Members-only (real-time, contact-required).
model Hangout {
  id           String   @id @default(cuid())
  userId       String   // host
  title        String   // "Coffee at Moda İskele"
  description  String?  // optional vibe note
  location     String   // free-text venue name / address — Maps link in description if useful
  neighborhood String?  // canonical Istanbul neighborhood (for filter + push targeting)
  startsAt     DateTime
  endsAt       DateTime
  status       String   @default("active") // active | expired | cancelled
  // Intent signal — 'group' means "bring whoever", 'solo' means
  // "looking for one person." Drives the feed filter chips and the
  // small badge on each card. Defaults to 'group' so legacy hangouts
  // (and forgetful hosts) stay in the broad-reach pool.
  meetMode     String   @default("group")  // 'group' | 'solo'
  // Optional photo of the meeting spot — single image, hosted on our
  // /app/api/files/hangouts/ tree. Resolves the "where is the group?"
  // problem at busy cafés. Same URL shape and regex enforcement as
  // DM image attachments.
  photo        String?
  createdAt    DateTime @default(now())

  // Lifecycle push tracking — set by the sweeper cron so we only fire each
  // notification once per hangout, even if the sweeper runs concurrently or
  // restarts mid-batch.
  notifiedStartingAt DateTime?  // "starts in 30 min" push has been sent
  // (recap push is implicitly tracked by status === 'expired' since the
  // sweeper finds expired hangouts by status === 'active' && endsAt < now,
  // and flips the status as part of the same pass)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  joins      HangoutJoin[]
  messages   HangoutMessage[]
  references HangoutReference[]

  @@index([status, endsAt])
  @@index([status, startsAt])     // sweeper queries by (status, startsAt window)
  @@index([neighborhood, status])
  @@map("hangouts")
}

// "I'm in" — one row per member who tapped Going on a hangout. Drives the
// avatar strip + count on each card and the recipient list for push when a
// new message lands.
model HangoutJoin {
  id        String   @id @default(cuid())
  hangoutId String
  userId    String
  createdAt DateTime @default(now())

  hangout Hangout @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hangoutId, userId])
  @@index([hangoutId])
  @@index([userId])
  @@map("hangout_joins")
}

// Lightweight comment thread on each hangout — for "running 10min late" /
// "we're at the back table" coordination, not full event chat.
model HangoutMessage {
  id        String   @id @default(cuid())
  hangoutId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  hangout Hangout @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hangoutId, createdAt])
  @@map("hangout_messages")
}

// Per-hangout, per-pair trust signal. Joiners reference the host; the host
// references each joiner. The aggregate goodHangouts / noShowCount counters
// on User are the source-of-truth-for-reads — every other surface (hangout
// card badge, member profile, application review) defers to those numbers.
//
// One reference per (hangout, from, to) tuple — re-clicking a button updates
// the existing row via vibe field, doesn't insert duplicates.
//
// vibe values:
//   - 'good'    — showed up, good chat. Increments toUser.goodHangouts.
//   - 'meh'     — showed up, fine. No counter movement (neutral).
//   - 'no_show' — said they were coming, never appeared. Increments
//                 toUser.noShowCount.
model HangoutReference {
  id         String   @id @default(cuid())
  hangoutId  String
  fromUserId String   // who left the reference
  toUserId   String   // who's being referenced
  vibe       String   // 'good' | 'meh' | 'no_show'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hangout  Hangout @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  fromUser User    @relation("HangoutReferencesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User    @relation("HangoutReferencesGot",   fields: [toUserId],   references: [id], onDelete: Cascade)

  @@unique([hangoutId, fromUserId, toUserId])  // one ref per pair per hangout
  @@index([toUserId, vibe])                     // for any rebuilds of the counters
  @@index([hangoutId])
  @@map("hangout_references")
}

// Lightweight "I'm around" pulse — between "I'd love to meet someone in
// theory" and "I'm posting a real hangout at X cafe at Y time." A user
// drops one of these to signal "free for the next few hours, message me
// if you're nearby." Surfaces in the hangouts feed as a different card
// type so it drives activity when no one's posted a real hangout.
//
// One active pulse per user at a time — posting a new one replaces the
// old one (enforced by the route handler, not the schema, so we can keep
// historical rows if we ever want a "you've been around 12 times" badge).
// 4-hour max TTL — fresh-only signal, enforced at create time.
model AvailabilityPulse {
  id           String   @id @default(cuid())
  userId       String
  neighborhood String?  // canonical Istanbul neighborhood (filter + targeting)
  note         String?  // "down for coffee" / "drinks after work" / etc.
  until        DateTime // when this pulse stops being visible
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([until])                  // feed query is `until > now`
  @@index([neighborhood, until])    // neighborhood-scoped feed
  @@index([userId])                 // for "find my active pulse"
  @@map("availability_pulses")
}

// "I'm visiting Istanbul" announcements — anonymous-friendly so non-members
// can post before they sign up (Couchsurfing-style growth lever). Contact
// info is gated client-side behind login to discourage scraping.
model VisitorAnnouncement {
  id           String   @id @default(cuid())
  userId       String?  // null when a non-member posts; linked when a member does
  name         String   // display name as entered
  email        String?  // shown only to logged-in members
  fromCity     String?  // "Berlin", "Mumbai"…
  intro        String   // why visiting / what they want
  startsOn     String   // YYYY-MM-DD
  endsOn       String   // YYYY-MM-DD
  neighborhood String?  // primary area
  contact      String?  // WhatsApp / Telegram / Instagram — gated client-side
  status       String   @default("active") // active | expired | removed
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, endsOn])
  @@index([neighborhood, status])
  @@map("visitor_announcements")
}

model SavedListing {
  userId    String
  listingId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId])
  @@map("saved_listings")
}

model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@map("rate_limits")
}
