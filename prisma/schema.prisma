  joinedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  // The participants page + RSVP gender-quota counts both hit
  // (eventId, status='approved'). Composite makes the count query
  // an index-only scan instead of a heap fetch.
  @@index([eventId, status])
  @@map("event_attendees")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  rating    Int
  text      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("reviews")
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  eventId        String
  amount         Float
  currency       String   @default("TRY")
  // RESERVED FIELDS — kept for future processor integration but currently
  // unused by any code path. Don't trust the default — every payment today
  // is collected manually (cash / wire / iyzilink) and admin reconciles via
  // /admin/payments. The "card" default is historic; new rows will keep it
  // until someone integrates a real processor and starts writing this
  // field properly. CSV export + audit snapshot both surface it as-is.
  method         String   @default("card")
  // RESERVED — never written by any code path. Future: 'iyzico' / 'stripe'
  // / 'manual' when a processor is wired up. Reading this today returns
  // null for every row; don't gate logic on it.
  provider       String?
  status         String   @default("pending")
  // RESERVED — never written by any code path. Future: processor's
  // transaction id for reconciliation. Reading this today returns null
  // for every row.
  transactionRef String?
  notes          String?
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([status])
  // The admin payments page orders by createdAt desc and pages
  // 500 rows at a time (PR 3 cap). Index on createdAt avoids a
  // full-table sort once the table grows past a few thousand rows.
  @@index([createdAt])
  // The "revenue by event" groupBy in the admin stats hits
  // (eventId, status) — composite avoids two separate index reads
  // intersected via bitmap-and.
  @@index([eventId, status])
  // The member-side RSVP cancel + admin participant-remove flows
  // hit (userId, eventId, status='pending'). Same composite serves
  // both, since the leading (userId, eventId) is the natural prefix.
  @@index([userId, eventId, status])
  @@map("payments")
}

model MemberApplication {
  id                   String    @id @default(cuid())
  firstName            String    @default("")
  lastName             String    @default("")
  fullName             String
  email                String
  phone                String?
  birthdate            String?
  gender               String?
  country              String?
  city                 String?
  neighborhood         String?
  instagram            String?
  linkedin             String?
  profession           String?
  timeInCity           String?
  reasonHere           String?
  // Legacy essay fields — collected before the apply form was consolidated.
  // Kept nullable so older applications keep their answers visible in admin
  // review. New applications populate aboutCommunity instead.
  whyJoin              String?
  enjoyWith            String?
  goodCommunity        String?
  // Replaces whyJoin + enjoyWith + goodCommunity — one prompt covering all
  // three: "What community are you looking for, and what would you bring to it?"
  aboutCommunity       String?
  interests            String[]
  socialStyles         String[]
  contribution         String?
  groupBehavior        String?
  removedFromCommunity String?
  toxicBehavior        String?
  // Replaces groupBehavior + removedFromCommunity + toxicBehavior — one
  // prompt: "Tell us about a time you handled a difficult social situation well."
  socialJudgment       String?
  // Languages spoken — multi-select on apply, populates User.languages on
  // approval (currently registration re-prompts; can later prefill).
  languages            String[]
  // "Open to…" pre-set at apply time; copied to User.openTo* on registration
  // so new members land discoverable in /members filters from day 1.
  openToCoffee         Boolean   @default(false)
  openToLanguage       Boolean   @default(false)
  openToHosting        Boolean   @default(false)
  profilePhoto         String?
  assignedClubs        String[]
  suggestion           String?
  suggestedBy          String?
  bio                  String?
  source               String?
  referredBy           String?
  status               String    @default("pending")
  reviewedBy           String?
  reviewNote           String?
  createdAt            DateTime  @default(now())
  reviewedAt           DateTime?
  escalated            Boolean   @default(false)
  escalatedNote        String?
  escalatedBy          String?
  escalatedAt          DateTime?
  ipAddress            String?
  userAgent            String?
  fingerprint          String?
  timezone             String?
  timezoneMismatch     Boolean   @default(false)
  disposableEmail      Boolean   @default(false)
  // Aggregate suspicion score computed at apply-time from the individual
  // signals above (timezoneMismatch / disposableEmail / fingerprint or IP
  // match / no phone / name similar to blacklist). Surfaces a single
  // "🚨 Sus N" badge on the admin card alongside the existing fit Score,
  // and gives admins a single dimension to sort the pending queue by when
  // the spam wave hits.
  suspicionScore       Int       @default(0)

  // Target city for the application — routes review into that city's
  // queue and determines which moderators see it. Backfilled to
  // Istanbul on 2026-05-29 and now required. The apply form
  // populates it from a city selector (defaulting to Istanbul).
  // Note: the existing free-text `city` field above is the applicant's
  // currently-resident city (a personal datum); targetCityId is the
  // *community* they're applying to. Different concepts.
  targetCityId         String
  targetCity           City      @relation(fields: [targetCityId], references: [id])

  reviewer User? @relation(fields: [reviewedBy], references: [id])

  @@index([email])
  @@index([phone])
  @@index([instagram])
  @@index([status])
  @@index([fingerprint, createdAt])
  @@index([ipAddress, createdAt])
  @@index([targetCityId])
  @@map("member_applications")
}

