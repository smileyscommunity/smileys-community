generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String?
  role              String   @default("member")
  color             String   @default("#f59e0b")
  bio               String?
  neighborhood      String?
  instagram         String?
  linkedin          String?
  lookingFor        String[]
  profileVisibility String   @default("everyone") // everyone | connections
  emailVerified     Boolean  @default(false)
  joinedAt          DateTime @default(now())

  phone          String?
  gender         String?
  profilePhoto   String?
  nationality    String?
  languages      String[]
  interests      String[]
  socialStyles   String[]
  status         String    @default("approved")
  membershipType String    @default("free")
  lastActive     DateTime?
  banReason      String?
  bannedAt       DateTime?
  appealNote     String?
  appealStatus   String?
  appealedAt     DateTime?
  warningCount   Int       @default(0)
  suspendedAt    DateTime?
  suspendedUntil DateTime?
  suspendedBy    String?
  suspensionNote String?
  referralCode   String?   @unique
  referralCount  Int       @default(0)
  partnerId      String?
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  // Highest TOTP step (Date.now()/30000) accepted for this user; codes at <= this
  // step are rejected to block replay within the 30s validity window.
  lastUsedTotpStep Int?
  tokenVersion   Int       @default(0)
  emailMarketing Boolean   @default(true)

  // "Open to…" availability flags — surface as badges on member cards and
  // filter on /members. Let willing matches show themselves without forcing
  // cold messages.
  openToCoffee     Boolean @default(false) // grab coffee with newcomers
  openToLanguage   Boolean @default(false) // language exchange
  openToHosting    Boolean @default(false) // host / show around visitors

  joinedEvents            EventAttendee[]
  clubMemberships         ClubMembership[]
  reviews                 Review[]
  payments                Payment[]
  eventPhotos             EventPhoto[]
  eventMessages           EventMessage[]
  notifications           Notification[]
  notifPrefs              NotificationPreference?
  reviewedApplications    MemberApplication[]
  reportsMade             Report[]                @relation("ReportsMade")
  reportsReceived         Report[]                @relation("ReportsReceived")
  sentMessages            DirectMessage[]         @relation("SentMessages")
  receivedMessages        DirectMessage[]         @relation("ReceivedMessages")
  dmReactions             DirectMessageReaction[]
  clubPosts               ClubPost[]
  clubPostLikes           ClubPostLike[]
  clubPostReplies         ClubPostReply[]
  neighborhoodPosts       NeighborhoodPost[]
  neighborhoodPostLikes   NeighborhoodPostLike[]
  neighborhoodPostReplies NeighborhoodPostReply[]
  visitorAnnouncements    VisitorAnnouncement[]
  hangouts                Hangout[]
  hangoutJoins            HangoutJoin[]
  hangoutMessages         HangoutMessage[]
  hangoutReferencesGiven  HangoutReference[]      @relation("HangoutReferencesGiven")
  hangoutReferencesGot    HangoutReference[]      @relation("HangoutReferencesGot")
  availabilityPulses      AvailabilityPulse[]
  clubPollVotes           ClubPollVote[]
  clubPhotos              ClubPhoto[]
  clubSpotlights          Club[]                  @relation("ClubSpotlight")
  communityPollVotes      CommunityPollVote[]
  connectionsRequested    MemberConnection[]      @relation("ConnectionRequester")
  connectionsReceived     MemberConnection[]      @relation("ConnectionReceiver")
  posts                   Post[]
  adminNotes              AdminNote[]
  cohostedEvents          EventCoHost[]
  pushSubscriptions       PushSubscription[]
  totpBackupCodes         TotpBackupCode[]
  sessions                Session[]
  listings                Listing[]
  savedListings           SavedListing[]
  listingAlerts           String[]
  checkedInCount          Int                     @default(0)
  // Hangout trust counters — denormalized for cheap reads on every hangout
  // card. Source of truth is HangoutReference rows; these get incremented
  // inside the same transaction that inserts a reference. If they ever
  // drift, recompute from references in a one-off backfill script.
  goodHangouts            Int                     @default(0)
  noShowCount             Int                     @default(0)
  partner                 Partner?                @relation(fields: [partnerId], references: [id])

  // Multi-city scaffolding. Backfill ran on 2026-05-29 and every row
  // got an Istanbul cityId; the column is now required. New users get
  // their city from the apply form's targetCityId on approval.
  cityId                  String
  city                    City                    @relation(fields: [cityId], references: [id])

  // Security
  failedLoginCount Int       @default(0)
  loginLockedUntil DateTime?
  knownIps         String[]
  // Browser FingerprintJS visitorId from the last successful login. Lets
  // admins cross-check "is this banned user back on a fresh email?" by
  // grepping for the same fingerprint across accounts. Cleared on signout.
  lastFingerprint  String?
  // A5 fix: rolling history of recent fingerprints (last 50 logins).
  // lastFingerprint only captured the most recent device, which meant
  // a banned user could log in once from a "clean" device to clear the
  // trail. The array keeps the cross-account match queryable across
  // history. Append-on-login, slice to 50, dedupe — same shape as
  // knownIps. Default [] so existing rows stay valid without a backfill.
  fingerprints     String[]   @default([])

  // Privacy & blocking
  profileViews     ProfileView[] @relation("ViewedProfile")
  profileViewsMade ProfileView[] @relation("ProfileViewer")
  blocksGiven      MemberBlock[] @relation("BlockGiver")
  blocksReceived   MemberBlock[] @relation("BlockReceiver")

  // Multi-city hosting capabilities (separate from ClubMembership
  // role='host' which is per-club).
  cityHostings     CityHost[]
  // Post-event survey responses this user has submitted.
  eventSurveys     EventSurvey[]
  // Quarterly NPS responses — one row per (userId, period).
  npsResponses     MemberNPS[]
  // Smileys Cup 2026 — predictions, pre-tournament bracket pick.
  cupPredictions   CupPrediction[]
  cupBracketPick   CupBracketPick?
  // Cup prize/sponsor relations — attribution + history. All
  // SetNull on delete: removing a user shouldn't erase prize or
  // sponsor records.
  cupSponsorsAdded   CupSponsor[]       @relation("CupSponsorAddedBy")
  cupPrizesAwardedTo CupPrize[]         @relation("CupPrizeAwardedTo")
  cupDonationsReviewed CupPrizeDonation[] @relation("CupDonationReviewer")

  @@map("users")
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())

  viewer User @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewed User @relation("ViewedProfile", fields: [viewedId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@index([viewedId, createdAt])
  @@map("profile_views")
}

model MemberBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockGiver", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockReceiver", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("member_blocks")
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  category     String // e.g. "Cafe", "Restaurant", "Studio"
  discount     String // e.g. "10% off everything"
  address      String
  neighborhood String
  lat          Float?
  lng          Float?
  logo         String?
  coverImage   String?
  website      String?
  instagram    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  users        User[]

  @@map("partners")
}

model Report {
  id            String    @id @default(cuid())
  reporterId    String
  reportedId    String
  eventId       String?
  listingId     String?   // Marketplace flag — reportedId is the listing owner; this points to the post.
  reason        String
  details       String?
  screenshot    String?
  status        String    @default("pending")
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  escalated     Boolean   @default(false)
  escalatedNote String?
  escalatedBy   String?
  escalatedAt   DateTime?
  createdAt     DateTime  @default(now())

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@index([status])
  @@index([listingId])
  @@map("reports")
}

model Blacklist {
  id          String   @id @default(cuid())
  email       String?  @unique
  phone       String?
  name        String?
  fingerprint String?
  ipAddress   String?
  reason      String
  bannedBy    String
  createdAt   DateTime @default(now())

  @@map("blacklist")
}

model ClubMembership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  role     String   @default("member")
  status   String   @default("approved")
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@map("club_memberships")
}

// City is the foundation of the multi-city scaffolding. Istanbul is
// the only row at launch but the schema is designed so adding Berlin
// / Lisbon / Dubai is a row insert, not a migration.
//
// status drives the city's lifecycle:
//   - launching → invite-only founding cohort, not visible publicly
//   - live      → full membership + events
//   - paused    → city is being wound down (no new applications)
//
// timezone / currency / country / lang are per-city so events,
// payments and notifications render with the right local context.
model City {
  id          String   @id @default(cuid())
  name        String   // "Istanbul"
  slug        String   @unique // "istanbul"
  country     String   // ISO 3166-1 alpha-2, e.g. "TR"
  timezone    String   // IANA, e.g. "Europe/Istanbul"
  currency    String   @default("TRY") // ISO 4217
  // language used for default emails / push copy in the city. The app
  // itself stays English-first; this is for outbound comms only.
  defaultLang String   @default("en")
  status      String   @default("launching") // launching | live | paused
  // The city's consul — appointed local lead. One per city. Carries
  // no auth power on its own (moderation still goes through role +
  // canActInCity) but defines the public face of Smileys in this
  // city: profile, contact, equity / revenue share, etc. Renders as
  // a "Smileys [City] · [Name] ✿" badge in member-facing surfaces.
  consulUserId String?
  createdAt   DateTime @default(now())

  users        User[]
  clubs        Club[]
  events       Event[]
  applications MemberApplication[]
  cityHosts    CityHost[]

  @@map("cities")
}

// CityHost is a per-city operational hosting capability — separate
// from club hosting (ClubMembership.role='host'). A city host can
// create events that aren't tied to a club: welcome weeks, cross-
// club socials, holidays, civic events. Consuls and admins implicitly
// have this capability; CityHost is for everyone else granted the
// scope.
//
// status=approved is the working state; revoked stays in the table
// for audit/history (deleting would lose the grantedBy trail). The
// canHostInCity helper filters by status.
model CityHost {
  id        String   @id @default(cuid())
  userId    String
  cityId    String
  status    String   @default("approved") // approved | revoked
  grantedBy String?  // admin who promoted this user
  grantedAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@index([cityId])
  @@index([userId])
  @@map("city_hosts")
}

model Club {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  category    String
  emoji       String
  color       String
  bgColor     String
  memberCount Int    @default(0)

  whatsappUrl        String?
  instagramUrl       String?
  rules              String?
  isPrivate          Boolean   @default(false)
  coverImage         String?
  coverImagePosition Int       @default(50)
  location           String?
  foundedAt          DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  spotlightUserId    String?
  spotlightNote      String?
  spotlightUpdatedAt DateTime?

  events        Event[]
  memberships   ClubMembership[]
  posts         ClubPost[]
  resources     ClubResource[]
  photos        ClubPhoto[]
  spotlightUser User?            @relation("ClubSpotlight", fields: [spotlightUserId], references: [id], onDelete: SetNull)

  // Clubs are city-scoped — Sailing Istanbul is a different club from
  // Sailing Berlin even if the category matches. Backfill ran on
  // 2026-05-29 and every existing row got an Istanbul cityId.
  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@map("clubs")
}

model Event {
  id                   String    @id @default(cuid())
  title                String
  description          String
  date                 String
  time                 String
  location             String
  neighborhood         String
  emoji                String    @default("🎉")
  price                Int       @default(0)
  memberPrice          Int?
  totalSpots           Int
  spotsLeft            Int
  limitedSpots         Boolean   @default(false)
  isPremium            Boolean   @default(false)
  membersOnly          Boolean   @default(false)
  vibes                String[]
  whatsappUrl          String?
  status               String    @default("published")
  address              String?
  coverImage           String?
  coverImagePosition   Int       @default(50)
  cancelledAt          DateTime?
  cancelReason         String?
  isRecurring          Boolean   @default(false)
  seriesId             String?
  meetingUrl           String?
  lat                  Float?
  lng                  Float?
  duration             Int?
  minAge               Int?
  maxAge               Int?
  language             String?
  difficulty           String?
  refundPolicy         String?
  registrationDeadline String?
  endTime              String?
  currency             String    @default("TRY")
  approvalRequired     Boolean   @default(false)
  featured             Boolean   @default(false)
  genderBalance        Boolean   @default(false)
  maleQuota            Int?
  // Female-side cap — mirror of maleQuota. Before this existed, the male
  // cap was the only enforcement, so an all-female RSVP wave could fill
  // 100% of spots and males got waitlisted indefinitely. With both set,
  // the event balances on both sides.
  femaleQuota          Int?
  turkishMaleQuota     Int?
  updatedAt            DateTime  @default(now()) @updatedAt
  // clubId is now optional. Events with a club still belong to a
  // curated sub-brand (Sailing Club, Eat Up Istanbul); events
  // without one are city-level events created by a CityHost or
  // consul (welcome weeks, cross-club socials, civic events). cityId
  // remains required regardless.
  clubId               String?
  hostId               String
  createdAt            DateTime  @default(now())

  // Set once the post-event survey dispatch has run for this event.
  // Drives idempotency on the cron — the sweep picks events with a
  // null surveyDispatchedAt and stamps this after notifying attendees.
  surveyDispatchedAt   DateTime?

  club      Club?           @relation(fields: [clubId], references: [id])
  attendees EventAttendee[]
  reviews   Review[]
  payments  Payment[]
  messages  EventMessage[]
  tags      EventTag[]
  cohosts   EventCoHost[]
  photos    EventPhoto[]
  surveys   EventSurvey[]

  // Events belong to a city. Derivable from the parent club today,
  // but storing it directly lets the events feed filter by the
  // viewer's city in one indexed query instead of joining through
  // clubs. Backfilled to Istanbul on 2026-05-29 and now required.
  cityId    String
  city      City            @relation(fields: [cityId], references: [id])

  @@index([date])
  @@index([clubId])
  @@index([status])
  @@index([hostId])
  @@index([cityId])
  // The events feed query filters by status + date and (optionally)
  // cityId. Singles on each column let Postgres bitmap-and them, but
  // a composite avoids the intersect step. (cityId, status, date)
  // matches both "upcoming in my city" (default feed) and
  // "all upcoming" (cross-city traveler view).
  @@index([cityId, status, date])
  @@map("events")
}

model EventPhoto {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_photos")
}

model EventCoHost {
  id      String   @id @default(cuid())
  eventId String
  userId  String
  addedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_cohosts")
}

// Post-event safety + quality signal. Two-question survey sent ~24h
// after an event ends. The wedge: none of the open-marketplace
// competitors (Internations, Meetup, Couchsurfing) have the trust to
// ask members "anything off?" — Smileys does, and that compounds.
//
//   anomaly       — Q1 "Anything off?". When true, the submit endpoint
//                   auto-files a Report against the event's host so
//                   moderators can review. anomalyNote carries the
//                   free-text detail.
//   wouldReturn   — Q2 "Would you go again?". The single best per-event
//                   quality signal. Aggregates roll up to host + club
//                   level for the curation moat.
//
// The userId stays server-side only — it's used to gate "one response
// per attendee" via the unique constraint and to support follow-up
// moderator outreach when an anomaly is reported. It's never exposed
// to the host in any UI.
model EventSurvey {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  anomaly     Boolean  // "Anything off?" yes/no
  anomalyNote String?  // optional free-text detail
  wouldReturn Boolean  // "Would you go again?"
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([anomaly])
  @@map("event_surveys")
}

// Smileys Cup 2026 — fixtures + member predictions.
//
// CupFixture is the canonical match record, seeded once for the group
// stage and topped up as knockout matchups firm up. Group-stage rows
// carry points=0 (we don't score them in v1 — too much data entry,
// low signal). Knockouts run R32 → R16 → QF → SF → Final because the
// 2026 expansion to 48 teams put the first knockout round at 32, not
// 16. Points scale with stakes:
//   R32  3   ·   R16  5   ·   QF  10   ·   SF  20   ·   Final  40
//
// homeTeam / awayTeam are nullable so we can seed knockout placeholders
// before group results are in: a row can have homeLabel "Winner Group
// A" with homeTeam null, then admin fills in the country code once
// the group concludes. ISO-3 codes throughout ("BRA", "ARG").
//
// winnerTeam is the trigger column — when admin sets it, the scoring
// route runs in the same transaction, awarding `points` to every
// matching CupPrediction.
model CupFixture {
  id           String   @id          // "2026-WC-R32-1", "2026-WC-G-A-1"
  round        String                 // "group" | "r32" | "r16" | "qf" | "sf" | "final"
  group        String?                // "A"–"L" (12 groups in the 48-team format), null for knockouts
  homeTeam     String?                // ISO-3, e.g. "BRA". Null when TBD
  awayTeam     String?
  homeLabel    String?                // Human label when team TBD ("Winner Group A")
  awayLabel    String?
  kickoffAt    DateTime
  venue        String?
  winnerTeam   String?                // Set by admin; triggers scoring of related predictions
  homeScore    Int?
  awayScore    Int?
  points       Int      @default(0)   // 0 (group) | 3 (R32) | 5 (R16) | 10 (QF) | 20 (SF) | 40 (F)
  // Stamp set by the cup-reminders sweeper (~30 min before kickoff)
  // once it has pushed "lock your pick" to subscribed members. Null
  // = not yet notified. Idempotency: once stamped, sweeper skips
  // the row on subsequent runs so a fixture only triggers one push
  // round, even if the cron fires multiple times inside the [T-35,
  // T-25] window.
  reminderSentAt DateTime?
  // Auto-scoring suggestion written by the cup-results sweeper from
  // football-data.org. The sweeper only writes; admin clicks "Apply"
  // in the fixtures UI to commit the values into homeScore /
  // awayScore / winnerTeam (which is what actually triggers the
  // prediction-scoring transaction). Keeping the suggestion separate
  // means a wrong external value never lands as truth — admin always
  // has the chance to override before scoring runs.
  //
  // suggestedStatus tracks the API's match state at the time of the
  // write so we can show "live" suggestions differently from
  // "finished" ones. FINISHED is the only state the UI offers an
  // Apply button for.
  suggestedHomeScore  Int?
  suggestedAwayScore  Int?
  suggestedWinnerTeam String?
  suggestedStatus     String?
  suggestedAt         DateTime?
  // Suggested team assignments for TBD knockout slots. Written by
  // the sweeper when football-data.org has resolved the home/away
  // teams for a R32/R16/QF/SF/F fixture upstream (i.e., once the
  // prior round wrapped). Admin clicks "Apply teams" in the admin
  // UI to commit them; once committed the fixture has homeTeam +
  // awayTeam set and the standard score-suggestion path takes over.
  suggestedHomeTeam   String?
  suggestedAwayTeam   String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  predictions  CupPrediction[]

  @@index([round, kickoffAt])
  @@index([reminderSentAt, kickoffAt])
  @@map("cup_fixtures")
}

// One row per (user, fixture). Upsert semantics: re-submitting before
// the fixture's kickoffAt overwrites. pointsAwarded is cached so the
// leaderboard query is a single SUM without joining CupFixture every
// time — written by the admin result-entry endpoint when winnerTeam
// is set.
model CupPrediction {
  id            String   @id @default(cuid())
  userId        String
  fixtureId     String
  pickedTeam    String                 // ISO-3
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pointsAwarded Int      @default(0)

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixture CupFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([userId, fixtureId])
  @@index([userId])
  @@index([fixtureId])
  @@map("cup_predictions")
}

// Pre-tournament bracket — one row per user, locked at first kickoff.
// championPick must appear in semifinalists[]. semifinalists must be
// exactly 4 distinct ISO codes. Scoring: champion 100, each correct
// semifinalist 25 (max 100). Tiebreaker on the leaderboard is earlier
// submittedAt.
model CupBracketPick {
  id            String   @id @default(cuid())
  userId        String   @unique
  championPick  String                 // ISO-3
  semifinalists String[]               // exactly 4 ISO-3 codes
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pointsAwarded Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cup_bracket_picks")
}

// Campaign — the container for any sponsored / fundraising drive.
// The Smileys Cup is the first one (slug: 'world-cup-2026'). Future
// tournaments (Euros 2028, Champions League final, etc.) or
// non-tournament drives (anniversary parties, referral pushes) get
// their own Campaign row + reuse the Sponsor/Prize/Donation
// machinery below.
//
// routeSlug is the URL alias — 'cup' for the cup (so links stay at
// /cup), or a normal slug that resolves under /campaigns/<slug>.
model Campaign {
  id          String   @id @default(cuid())
  slug        String   @unique  // 'world-cup-2026', 'euros-2028', etc.
  name        String
  emoji       String?
  tagline     String?
  description String?
  coverImage  String?
  status      String   @default("active")  // 'draft' | 'active' | 'wrapped' | 'archived'
  startsAt    DateTime?
  endsAt      DateTime?
  // Public URL alias. 'cup' keeps the existing /cup URL for the
  // World Cup; future campaigns resolve at /campaigns/<routeSlug>.
  routeSlug   String   @default("cup")
  // Whether this campaign has a fixtures/results admin surface
  // (currently /admin/cup; future tournaments would get their own).
  // Drives the "Fixtures + results →" pill on the campaign-detail
  // admin page so we don't have to hardcode `slug === 'world-cup-2026'`
  // every time a new tournament campaign lands.
  hasFixtures Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sponsors    CupSponsor[]
  prizes      CupPrize[]
  donations   CupPrizeDonation[]

  @@index([status])
  @@map("campaigns")
}

// Cup prizes + sponsors. Three thin models for a public-facing
// prize board on /cup, with a member/visitor "donate a prize"
// form that admins triage in /admin/cup. All three carry a
// campaignId so the machinery generalizes to future Campaign rows
// — the names keep the Cup* prefix for migration safety (table
// names + existing imports), but conceptually these are
// Campaign-scoped.
//
// Display vs back-of-house:
//   • CupSponsor + CupPrize are display state — the visible board
//     on /cup reads from these. Active rows render; archived
//     rows are kept for history.
//   • CupPrizeDonation is the submission queue. Anyone (auth not
//     required) can POST one. Admin reviews and on approval
//     creates the corresponding Sponsor + Prize via /admin/cup.
//     The donation row stays as audit history.
model CupSponsor {
  id          String   @id @default(cuid())
  // campaignId is nullable for migration safety — fresh installs
  // and existing rows get populated by the seed/backfill script
  // (scripts/seed-cup.ts upserts the world-cup-2026 Campaign).
  // Routes always filter by campaign so the column is
  // operationally required even though the FK is nullable.
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  slug        String   @unique  // url-safe, used in CSS targeting / future detail pages
  name        String
  blurb       String?  // 1–2 sentences for the prize card
  logoUrl     String?  // /app/api/files/... or external https
  websiteUrl  String?
  instagramUrl String?
  status      String   @default("active")  // 'pending' | 'active' | 'archived'
  // Optional FK to the User who first added them — handy for
  // attribution when a member proposes a sponsor via the donate
  // form.
  addedByUserId String?
  addedBy       User?    @relation("CupSponsorAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prizes      CupPrize[]
  @@index([campaignId, status])
  @@map("cup_sponsors")
}

model CupPrize {
  id          String   @id @default(cuid())
  // Campaign FK — same nullable-for-migration pattern as
  // CupSponsor. Seed populates.
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  // rank: 1, 2, 3 for the podium positions. null = "spot prize"
  // (anything outside the top 3 — runners-up, raffles, etc.).
  rank        Int?
  status      String   @default("draft")  // 'draft' | 'active' | 'awarded' | 'archived'
  // Optional sponsor link. Some prizes (e.g. a year of VIP from
  // Smileys itself) don't have an external sponsor — left null.
  sponsorId   String?
  sponsor     CupSponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  // Awarded-to: filled when the prize is handed out. Lets us show
  // a "won by ___" line on archived prizes for history.
  awardedToUserId String?
  awardedTo       User?   @relation("CupPrizeAwardedTo", fields: [awardedToUserId], references: [id], onDelete: SetNull)
  awardedAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([campaignId, status, rank])
  @@map("cup_prizes")
}

model CupPrizeDonation {
  id          String   @id @default(cuid())
  // Campaign FK — same nullable-for-migration pattern. Public
  // donate form will set this from the URL slug (or default to
  // the cup campaign when posted from /cup).
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Donor identity. We collect name + email so admin can follow
  // up. Phone optional. Organization optional (individual donors
  // are welcome).
  donorName        String
  donorEmail       String
  donorOrganization String?
  donorPhone       String?
  // What they're offering.
  prizeTitle       String
  prizeDescription String
  estimatedValue   Int?     // in TRY (or whatever currency, label in UI)
  notes            String?
  // Review state. Linked rows are stamped when an admin clicks
  // "convert to prize" so we can trace prize ↔ donation history.
  status           String   @default("pending")  // 'pending' | 'approved' | 'declined'
  reviewedByUserId String?
  reviewedBy       User?    @relation("CupDonationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?  // optional admin note (private)
  linkedSponsorId  String?
  linkedPrizeId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([campaignId, status, createdAt])
  @@map("cup_prize_donations")
}

// Quarterly Net Promoter Score survey. One row per (userId, period)
// — the unique constraint prevents a user from double-responding in
// the same quarter. Period is "YYYY-Qn" (e.g. "2026-Q2"), computed
// at dispatch time in lib/nps.ts.
//
// userId stays server-side: admin endpoints never expose it. Same
// anonymity wedge as EventSurvey — honest responses depend on the
// member trusting nothing is traceable to their face. Soft outreach
// to detractors (admin → "anything we can do better?") goes via
// notification by score band, not by name.
//
// score is 0–10. Promoter = 9–10, Passive = 7–8, Detractor = 0–6.
// NPS = %promoters − %detractors (range −100 to +100).
model MemberNPS {
  id        String   @id @default(cuid())
  userId    String
  score     Int      // 0–10
  comment   String?  // optional free-text
  period    String   // "YYYY-Qn", e.g. "2026-Q2"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period, createdAt])
  @@index([score])
  @@map("member_nps")
}

model TagGroup {
