// One-time recovery codes for users with TOTP 2FA enabled. Generated as a
// batch at enrollment; consumed at /api/auth/2fa/verify as an alternative
// to the 6-digit TOTP code when the user has lost their device. Stored as
// SHA-256 hashes (same rationale as the reset/verify tokens above: codes
// are high-entropy random strings, so unsalted hashing is sufficient and
// lets us look up by hash). `usedAt` lets users see "5 of 10 codes used".
//
// Cleared in two places:
//   - DELETE /api/auth/2fa/setup (user disables 2FA)
//   - account-deletion route
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("totp_backup_codes")
}

// Per-device session row. The ID is embedded as the `jti` claim in the
// session JWT issued at login. `getSession()` checks the row exists +
// hasn't been explicitly revoked on every authenticated request.
//
// Why this exists: the `tokenVersion` mechanism on User invalidates EVERY
// session for a user at once (logout, password reset, role change), but
// can't revoke a single device. With this table, users can see all their
// active devices in /settings and sign out individual ones (lost laptop,
// borrowed phone).
//
// Legacy compat: sessions issued before this column was added carry no
// `jti` claim. getSession() treats those as "legacy mode" — still valid
// until the 7-day JWT expiry, but not tracked here. After 7 days, every
// session is tracked.
model Session {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt]) // for the cleanup sweeper
  @@map("sessions")
}

