// #5 monitoring: per-sweeper liveness. Each cron handler calls
// recordCronRun on success/failure; the admin dashboard flags
// any sweeper that hasn't checked in within its expected
// cadence. Without this, a sweeper silently failing (bad
// CRON_SECRET, crashed process, DNS blip) goes un-noticed
// until users complain that reminders aren't firing.
model CronRun {
  id            String    @id @default(cuid())
  name          String    @unique  // e.g. 'sweep-cup-reminders'
  lastSuccessAt DateTime?
  lastError     String?
  lastErrorAt   DateTime?
  totalRuns     Int       @default(0)
  totalErrors   Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@map("cron_runs")
}

// #4 monitoring: every send*Email .catch path that previously
// went silent now also writes a row here. Lets the admin
// dashboard alert when SMTP/Resend is broken instead of waiting
// for members to complain. Auto-pruned by the existing
// retention sweeper (see /admin/retention).
model EmailFailure {
  id         String   @id @default(cuid())
  // The function name from lib/email.ts, e.g. 'sendRefundEmail'
  // — used for grouping in the dashboard ("X failures of type Y").
  helper     String
  // The recipient email (already in our DB; this column is for
  // quick eyeballing without joining back through context).
  recipient  String
  // Error message from the helper. Capped at 500 to bound row
  // size — full stack lives in the server console.
  error      String
  // Whatever context the caller had (paymentId, eventId, userId,
  // etc.) so an admin investigating can grep their way to the
  // specific record without leaving the dashboard.
  context    Json?
  createdAt  DateTime @default(now())

  @@index([helper])
  @@index([createdAt])
  @@map("email_failures")
}

