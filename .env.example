# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smileys_db"

# Authentication
JWT_SECRET="your_jwt_secret_here"
CRON_SECRET="your_cron_secret_here"

# AI & External Services
OPENAI_API_KEY="sk-..."
RESEND_API_KEY="re_..."

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_EMAIL="mailto:hello@yourdomain.com"

# Monitoring & Analytics
SENTRY_ORG="..."
SENTRY_PROJECT="..."
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Security (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="..."
TURNSTILE_SECRET_KEY="..."

# App Configuration
EMAIL_FROM="Your App <info@yourdomain.com>"
ADMIN_EMAIL="admin@yourdomain.com"
APP_URL="http://localhost:3000/app"

# Smileys Cup auto-scoring (football-data.org free tier — sign up at
# https://www.football-data.org/client/register). Used by the
# sweep-cup-results cron to pull FIFA World Cup results every 5
# minutes and write per-fixture suggestions admin one-click applies
# from the Fixtures + results admin tab. Without this key the cron
# returns 503 and the panel silently falls back to manual entry —
# nothing breaks, no auto-suggestions.
FOOTBALL_DATA_API_KEY="..."
